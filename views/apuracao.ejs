<%- include("partes/topo", { titulo: "Boletim de urna" }) %>
<nav aria-label="breadcrumb" class="d-print-none"><ol class="breadcrumb bg-transparent px-0">
    <li class="breadcrumb-item"><% if (usuario.papel === 'admin') { %><a href="/admin/turmas">Todas as turmas</a><% } else { %><a href="/painel">Minhas turmas</a><% } %></li>
    <li class="breadcrumb-item"><a href="/turmas/<%= turma.id %>"><%= turma.nome %></a></li>
    <li class="breadcrumb-item active">Apuração</li>
</ol></nav>
<div class="card">
    <div class="card-body">
        <h1 class="h2 text-center mb-0">BOLETIM DE URNA</h1>
        <p class="text-center text-muted"><%= turma.nome %> · <%= agora %></p>
        <%
            // Como na eleição de verdade: a porcentagem de cada candidato é
            // calculada sobre os votos válidos (brancos e nulos não entram).
            const validos = total - brancos - nulos;
            const pct = (parte, todo) => (todo ? (Math.round(parte * 1000 / todo) / 10).toLocaleString('pt-BR') : '0') + '%';
        %>
        <table class="table table-bordered text-center">
            <thead class="bg-primary text-light">
                <tr><th>NÚMERO</th><th>CANDIDATO</th><th>VOTOS</th><th>% DOS VÁLIDOS</th></tr>
            </thead>
            <tbody>
            <% resultado.forEach((c, i) => { %>
                <tr class="<%= i === 0 && c.votos > 0 && (resultado.length === 1 || c.votos > resultado[1].votos) ? 'table-success font-weight-bold' : '' %>">
                    <td><%= c.numero %></td>
                    <td><%= c.nome %></td>
                    <td><%= c.votos %></td>
                    <td><%= pct(c.votos, validos) %></td>
                </tr>
            <% }) %>
            </tbody>
        </table>

        <table class="table table-bordered text-center resumo-votos">
            <thead class="bg-light">
                <tr><th colspan="2">RESUMO</th><th>VOTOS</th><th>% DO TOTAL</th></tr>
            </thead>
            <tbody>
                <tr class="font-weight-bold"><td colspan="2">Votos válidos</td><td><%= validos %></td><td><%= pct(validos, total) %></td></tr>
                <tr><td colspan="2">Brancos</td><td><%= brancos %></td><td><%= pct(brancos, total) %></td></tr>
                <tr><td colspan="2">Nulos</td><td><%= nulos %></td><td><%= pct(nulos, total) %></td></tr>
            </tbody>
            <tfoot><tr class="font-weight-bold"><td colspan="2">TOTAL DE VOTOS</td><td><%= total %></td><td><%= total ? '100%' : '0%' %></td></tr></tfoot>
        </table>
        <% if (resultado.length > 1 && resultado[0].votos > 0 && resultado[0].votos === resultado[1].votos) { %>
        <div class="alert alert-warning">Houve empate no primeiro lugar.</div>
        <% } %>
        <button type="button" class="btn btn-outline-primary d-print-none" onclick="window.print()">Imprimir boletim</button>
    </div>
</div>

<div class="card mt-4 d-print-none">
    <div class="card-body">
        <h2 class="h5">Iniciar nova eleição</h2>
        <p class="small text-muted">Apaga todos os votos desta turma. Os candidatos continuam cadastrados.</p>
        <form action="/turmas/<%= turma.id %>/zerar" method="POST" class="form-inline" onsubmit="return confirm('Apagar todos os votos desta turma?')">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <label class="mr-2" for="senha">Sua senha</label>
            <input class="form-control mr-2" id="senha" name="senha" type="password" autocomplete="current-password" required>
            <button class="btn btn-danger">Zerar votos</button>
        </form>
    </div>
</div>
<%- include("partes/rodape") %>
