<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Encerrar votação · Urna Eletrônica</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="navbar navbar-dark bg-primary">
    <span class="navbar-brand"><img src="/img/juslany.png" alt="Escola Municipal Juslany Flores"></span>
</nav>
<main class="container my-4">
<div class="card mx-auto caixa-estreita">
    <div class="card-body">
        <h1 class="h4">Encerrar votação</h1>
        <p class="text-muted"><%= turma.nome %>. Só o professor da turma pode encerrar.</p>
        <% if (erro) { %><div class="alert alert-danger"><%= erro %></div><% } %>
        <form action="/urna/<%= turma.id %>/encerrar" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <div class="form-group">
                <label for="senha">Senha do professor</label>
                <input class="form-control" id="senha" name="senha" type="password" autocomplete="current-password" required autofocus>
            </div>
            <button class="btn btn-danger btn-block">Encerrar e ver a apuração</button>
            <a class="btn btn-link btn-block" href="/urna/<%= turma.id %>">Voltar para a urna</a>
        </form>
    </div>
</div>
</main>
</body>
</html>
